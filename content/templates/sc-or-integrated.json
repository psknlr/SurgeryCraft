    {"id": "ultrasound", "type": "ultrasound-machine", "x": 0.2, "z": -3.9, "label": {"zh-CN": "超声 / 经食道超声", "en": "Ultrasound / TOE"}},
    {"id": "airway", "type": "sc-difficult-airway-trolley", "x": -1.4, "z": -4.05, "label": {"zh-CN": "困难气道车", "en": "Difficult airway trolley"}},
    {"id": "display-1", "type": "sc-ceiling-display", "x": 1.6, "z": 2.6, "rot": 180, "label": {"zh-CN": "吊臂显示器 1", "en": "Ceiling display 1"}},
    {"id": "display-2", "type": "sc-ceiling-display", "x": -0.6, "z": -2.7, "label": {"zh-CN": "吊臂显示器 2", "en": "Ceiling display 2"}}
  ],
