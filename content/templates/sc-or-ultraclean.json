{
  "schema": "clinicalcraft/room-template@1",
  "id": "sc-or-ultraclean",
  "name": {"zh-CN": "超净层流手术室（Ⅰ级洁净）", "en": "Ultra-clean laminar-flow OR (Class I)"},
  "description": {"zh-CN": "9 × 9 m 超净手术室，用于关节置换、心脏与器官移植等植入物手术：3.2 × 3.2 m 单向流送风天花带玻璃导流裙边，手术台和器械台都在保护区内；移动 C 形臂、双器械台、双吊塔与 4K 显示。设计目标：GB 50333 Ⅰ级（手术区 ISO 5、浮游菌 ≤ 5 CFU/m³）、DIN 1946-4 Ⅰa（TAV）与 HTM 03-01 超净通风（≤ 10 CFU/m³）。", "en": "9 × 9 m ultra-clean OR for implant surgery (arthroplasty, cardiac, transplant): a 3.2 × 3.2 m unidirectional supply ceiling with glass skirts covering both the table and the instrument tables, a mobile C-arm, two back tables, both pendants and 4K displays. Design targets: GB 50333 Class I (ISO 5 at the operating zone, ≤ 5 CFU/m³), DIN 1946-4 class Ia (TAV) and HTM 03-01 ultra-clean ventilation (≤ 10 CFU/m³)."},
  "kind": "operating-room",
  "size": {"w": 9, "d": 9},
  "floor": "sc-or-floor",
  "partitions": [
    {"side": "n", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": 2.6, "width": 1.6, "height": 2.6}]},
    {"side": "w", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": 3.1, "width": 1.4, "height": 2.6}, {"kind": "sliding-door", "offset": -1.2, "width": 1.4, "height": 2.6}]},
    {"side": "e", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": 3.1, "width": 1.4, "height": 2.6}, {"kind": "sliding-door", "offset": -1.2, "width": 1.4, "height": 2.6}]},
    {"side": "s", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": -2.2, "width": 2.4, "height": 3}]}
