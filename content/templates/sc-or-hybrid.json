    {"id": "circulating-nurse", "role": "nurse", "name": {"zh-CN": "巡回护士", "en": "Circulating nurse"}, "x": 2.4, "z": 3.6, "rot": 180, "greeting": {"zh-CN": "我负责核查和清点，开台前我们一起做 Sign in 和 Time out。", "en": "I run the checklist and the counts — we'll do the sign-in and the time-out together before you start."}},
    {"id": "anaesthetist", "role": "attending", "name": {"zh-CN": "麻醉医生", "en": "Anaesthetist"}, "x": -2.85, "z": 0.4, "rot": 90, "greeting": {"zh-CN": "麻醉机已完成开机检查，监测按日本麻醉科学会指南：SpO₂、ETCO₂、心电、无创血压、体温和肌松监测。", "en": "The machine check is done; monitoring follows the JSA guideline — SpO₂, capnography, ECG, NIBP, temperature and neuromuscular monitoring."}}
