    {"id": "canopy", "type": "sc-laminar-canopy", "x": 0.5, "z": 0.2, "label": {"zh-CN": "层流送风天花", "en": "Laminar-flow ceiling"}},
    {"id": "table", "type": "operating-table", "x": 0.5, "z": 0.2, "rot": 90, "label": {"zh-CN": "手术床", "en": "Operating table"}},
