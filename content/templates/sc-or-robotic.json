  "patientSlots": [
    {"id": "slot", "x": 0, "z": -0.3, "rot": 90, "posture": "lying", "bed": "table", "accepts": ["operating-room"], "monitor": "monitor"}
  ],
  "zones": [
    {"id": "sterile", "name": {"zh-CN": "手术间（限制区）", "en": "Operating room (restricted)"}, "rect": {"x": 0, "z": 0, "w": 9, "d": 9}, "roles": ["clinician", "attending", "nurse", "porter"]}
  ],
  "capabilities": ["surgery", "anesthesia", "airway", "ventilator", "capnography", "cardiac-monitor", "oxygen", "suction", "infusion-pump", "iv-access", "medications", "records"],
  "tags": ["surgery", "restricted", "robotic", "mis"]
