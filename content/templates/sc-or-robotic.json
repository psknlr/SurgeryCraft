    {"id": "records", "type": "records-terminal", "x": 2, "z": 4.025, "rot": 180, "label": {"zh-CN": "手术室电子病历终端", "en": "Theatre EHR terminal"}},
    {"id": "pacs", "type": "sc-wall-display", "x": 4.265, "z": 1.2, "rot": 270, "label": {"zh-CN": "PACS / 一体化显示屏", "en": "PACS & integration display"}},
    {"id": "control-panel", "type": "sc-or-control-panel", "x": 0.6, "z": 4.275, "rot": 180, "label": {"zh-CN": "环境控制面板", "en": "OR control panel"}},
    {"id": "checklist", "type": "sc-who-checklist", "x": 3.3, "z": 4.285, "rot": 180, "label": {"zh-CN": "WHO 手术安全核查板", "en": "WHO Surgical Safety Checklist"}},
    {"id": "grille-1", "type": "sc-return-grille", "x": 3.9, "z": -4.285},
    {"id": "grille-2", "type": "sc-return-grille", "x": -3.9, "z": 4.285, "rot": 180},
    {"id": "sanitizer", "type": "hand-sanitizer", "x": -0.6, "z": 4, "label": {"zh-CN": "手消毒液", "en": "Hand rub"}},
    {"id": "robot", "type": "sc-robotic-patient-cart", "x": 0.5, "z": -1.75, "label": {"zh-CN": "床旁机械臂系统", "en": "Robotic patient-side cart"}},
    {"id": "console", "type": "sc-robotic-console", "x": 0.9, "z": 3.3, "label": {"zh-CN": "医生控制台", "en": "Surgeon console"}},
    {"id": "vision", "type": "sc-robotic-vision-cart", "x": -3.6, "z": 0.35, "rot": 90, "label": {"zh-CN": "视频系统车", "en": "Vision cart"}},
    {"id": "display-1", "type": "sc-ceiling-display", "x": 1.6, "z": 2.6, "rot": 180, "label": {"zh-CN": "吊臂显示器", "en": "Ceiling display"}},
    {"id": "display-2", "type": "sc-ceiling-display", "x": -0.6, "z": -2.9, "label": {"zh-CN": "吊臂显示器 2", "en": "Ceiling display 2"}}
