{
  "schema": "clinicalcraft/room-template@1",
  "id": "sc-or-robotic",
  "name": {"zh-CN": "机器人手术室", "en": "Robotic surgery OR"},
  "description": {"zh-CN": "9 × 9 m 机器人辅助手术室：床旁机械臂系统停靠在手术床旁，医生控制台位于房间一角并可看到术野与团队，视频系统车供台上助手观看；其余配置同一体化手术室（层流天花、双吊塔、4K 显示、WHO 核查）。", "en": "9 × 9 m robotic-assisted surgery OR: the patient-side cart docks beside the table, the surgeon console sits in a corner with a view of the field and the team, and the vision cart serves the bedside assistant; otherwise as the integrated OR (laminar ceiling, two pendants, 4K displays, WHO checklist)."},
  "kind": "operating-room",
  "size": {"w": 9, "d": 9},
  "floor": "sc-or-floor",
  "partitions": [
    {"side": "n", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": 2.6, "width": 1.6, "height": 2.6}]},
    {"side": "w", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": 3.1, "width": 1.4, "height": 2.6}, {"kind": "sliding-door", "offset": -1.2, "width": 1.4, "height": 2.6}]},
    {"side": "e", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": 3.1, "width": 1.4, "height": 2.6}, {"kind": "sliding-door", "offset": -1.2, "width": 1.4, "height": 2.6}]},
    {"side": "s", "material": "sc-or-wall", "base": "sc-or-wall-base", "height": 4.6, "openings": [{"kind": "sliding-door", "offset": -2.2, "width": 2.4, "height": 3}]}
  ],
  "sign": {"text": {"zh-CN": "手术室 · 机器人", "en": "OR · Robotic"}, "color": "#2f7fd1"},
  "lights": [
    {"x": -3, "z": -3},
    {"x": 3, "z": -3},
    {"x": -3, "z": 3},
    {"x": 3, "z": 3}
