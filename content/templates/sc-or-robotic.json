    {"id": "scissors", "type": "sc-metzenbaum-scissors", "x": 2.61, "z": 1.31, "label": {"zh-CN": "解剖剪", "en": "Dissecting scissors"}, "y": 0.9},
    {"id": "artery-forceps", "type": "sc-artery-forceps", "x": 2.79, "z": 1.31, "label": {"zh-CN": "止血钳", "en": "Artery forceps"}, "y": 0.9},
    {"id": "esu-pencil", "type": "sc-esu-pencil", "x": 2.99, "z": 1.31, "label": {"zh-CN": "电刀笔", "en": "ESU pencil"}, "y": 0.9},
    {"id": "mayo", "type": "sc-mayo-stand", "x": 1.1, "z": 1.25, "label": {"zh-CN": "Mayo 托盘", "en": "Mayo stand"}},
