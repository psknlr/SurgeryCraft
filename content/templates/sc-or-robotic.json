    {"id": "console", "type": "sc-robotic-console", "x": 0.9, "z": 3.3, "label": {"zh-CN": "医生控制台", "en": "Surgeon console"}},
    {"id": "vision", "type": "sc-robotic-vision-cart", "x": -3.6, "z": 0.35, "rot": 90, "label": {"zh-CN": "视频系统车", "en": "Vision cart"}},
    {"id": "display-1", "type": "sc-ceiling-display", "x": 1.6, "z": 2.6, "rot": 180, "label": {"zh-CN": "吊臂显示器", "en": "Ceiling display"}},
    {"id": "display-2", "type": "sc-ceiling-display", "x": -0.6, "z": -2.9, "label": {"zh-CN": "吊臂显示器 2", "en": "Ceiling display 2"}}
  ],
  "patientSlots": [
    {"id": "slot", "x": 0, "z": -0.3, "rot": 90, "posture": "lying", "bed": "table", "accepts": ["operating-room"], "monitor": "monitor"}
  ],
  "staff": [
    {"id": "scrub-nurse", "role": "nurse", "name": {"zh-CN": "洗手护士", "en": "Scrub nurse"}, "x": 2.55, "z": 1.95, "rot": 180, "greeting": {"zh-CN": "器械台已按清单摆好，纱布已清点。要什么器械说一声，我递给您。", "en": "The set-up is laid out to the tray list and the swabs are counted. Call for what you need and I'll pass it."}},
    {"id": "circulating-nurse", "role": "nurse", "name": {"zh-CN": "巡回护士", "en": "Circulating nurse"}, "x": -0.3, "z": 3.4, "rot": 180, "greeting": {"zh-CN": "我负责核查和清点，开台前我们一起做 Sign in 和 Time out。", "en": "I run the checklist and the counts — we'll do the sign-in and the time-out together before you start."}},
    {"id": "anaesthetist", "role": "attending", "name": {"zh-CN": "麻醉医生", "en": "Anaesthetist"}, "x": -2.4, "z": 0.3, "rot": 90, "greeting": {"zh-CN": "麻醉机已完成开机检查，监测按日本麻醉科学会指南：SpO₂、ETCO₂、心电、无创血压、体温和肌松监测。", "en": "The machine check is done; monitoring follows the JSA guideline — SpO₂, capnography, ECG, NIBP, temperature and neuromuscular monitoring."}}
  ],
