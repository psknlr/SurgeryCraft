{
  "schema": "clinicalcraft/skill@1",
  "id": "impf_closing_counts",
  "name": {
    "zh-CN": "关闭前清点与 RF 扫描",
    "en": "Closing counts and the RF scan"
  },
  "description": {
    "zh-CN": "先到患者身旁（本手术间），在关闭前完成关闭体腔前与关闭皮肤前清点；即使清点相符也用 RF 检测棒扫描患者（AORN），再做最终清点。清点是逐件核对的记录：相符后才关闭；关闭后在 WHO 核查板上做离室核对（Sign out）。",
    "en": "From the patient's side in this OR, before closure: count before closing the cavity and before skin closure; scan the patient with the RF wand even when the counts agree (AORN); then the final count. The count is a record kept item by item: close once it is reconciled, then do the WHO Sign Out on the checklist board."
  },
  "params": {
    "patient": {
      "type": "entity",
      "default": "$patient",
      "description": {
        "zh-CN": "患者（默认本次手术的患者）",
        "en": "The patient (default: this operation's patient)"
      }
    }
  },
  "safety": "physical",
  "steps": [
    {
      "id": "go",
      "tool": "navigate_to",
      "args": {
        "target": "${patient}"
      },
      "when": {
        "not": {
          "actorNear": "${patient}",
          "range": 3
        }
      }
    },
    {
      "id": "board",
      "tool": "find_objects",
      "args": {
        "type": "sc-count-board",
        "room": "here",
        "limit": 1
      }
    },
    {
      "id": "wand",
      "tool": "find_objects",
      "args": {
        "type": "sc-rf-wand",
        "room": "here",
        "limit": 1
      }
    },
    {
      "id": "cavity",
      "tool": "interact_object",
      "args": {
        "target": "${steps.board.data.entities.0.id}",
        "operation": "cavity_count"
      },
      "when": {
        "entityState": "${steps.board.data.entities.0.id}",
        "state": [
          "baseline"
        ]
      }
    },
    {
      "id": "closing",
      "tool": "interact_object",
      "args": {
        "target": "${steps.board.data.entities.0.id}",
        "operation": "closing_count"
      },
      "when": {
        "entityState": "${steps.board.data.entities.0.id}",
        "state": [
          "baseline",
          "cavity"
        ]
      }
    },
    {
      "id": "take_wand",
      "tool": "interact_object",
      "args": {
        "target": "${steps.wand.data.entities.0.id}",
        "operation": "pick_up"
      },
      "when": {
        "entityState": "${steps.wand.data.entities.0.id}",
        "state": [
          "ready",
          "clear",
          "detected"
        ]
      }
    },
    {
      "id": "scan",
      "tool": "interact_object",
      "args": {
        "target": "${steps.wand.data.entities.0.id}",
        "operation": "scan"
      },
      "when": {
        "entityState": "${steps.board.data.entities.0.id}",
        "state": [
          "closing"
        ]
      }
    },
    {
      "id": "final",
      "tool": "interact_object",
      "args": {
        "target": "${steps.board.data.entities.0.id}",
        "operation": "final_count"
      },
      "when": {
        "entityState": "${steps.board.data.entities.0.id}",
        "state": [
          "closing"
        ]
      }
    },
    {
      "id": "dock_wand",
      "tool": "interact_object",
      "args": {
        "target": "${steps.wand.data.entities.0.id}",
        "operation": "put_down"
      },
      "onError": "continue"
    }
  ],
  "postconditions": [
    {
      "entityState": "${steps.board.data.entities.0.id}",
      "state": "reconciled"
    }
  ],
  "recovery": [
    {
      "on": [
        "SPATIAL_REQUIREMENT_UNMET",
        "NOT_IN_RANGE",
        "NOT_VISIBLE",
        "NO_INTERACTION_POINT"
      ],
      "strategy": "replan"
    }
  ]
}
